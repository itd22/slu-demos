{
  "tasks": {
    "dev": "deno run --allow-read --allow-write --watch ./src/main.ts",
    "bundle": "deno run -A npm:esbuild ./src/main.ts --bundle --minify --format=esm --outfile=./dist/main.js --external:jsr:@seelen-ui/lib",
    "bundle:debug": "deno run -A npm:esbuild ./src/main.ts --bundle --format=esm --outfile=./dist/main.js --external:jsr:@seelen-ui/lib"
  },
  "imports": {
    "@seelen-ui/lib": "jsr:@seelen-ui/lib@^2.2.0"
  },
  "compilerOptions": {
    "lib": ["dom", "deno.ns"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  }
}
