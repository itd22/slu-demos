{
  "nodeModulesDir": "auto",
  "workspace": [
    "widgets/*"
  ],
  "compilerOptions": {
    "module": "esnext",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "moduleResolution": "bundler"
  },
  "exclude": [
    "node_modules",
    "build",
    "**/dist/**"
  ],
  "imports": {
    "@seelen-ui/lib": "npm:@seelen-ui/lib@^2.5.8"
  }
}
